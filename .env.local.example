# Copie ce fichier en ".env.local" et remplis avec tes vraies valeurs
# (trouvables dans Supabase > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://ton-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ta-cle-anon-publique

# La clé service_role a un accès TOTAL à la base (contourne le RLS).
# Ne JAMAIS l'exposer côté client. Utile plus tard pour des tâches admin
# côté serveur uniquement (ex: le back-office de vérification des comptes).
# SUPABASE_SERVICE_ROLE_KEY=ta-cle-service-role
